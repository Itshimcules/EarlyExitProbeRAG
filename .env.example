MODEL_BACKEND=mock
RETRIEVAL_MODE=keyword
VECTOR_INDEX_PATH=.cache/wiki-vector-index.json
CHROMA_PERSIST_PATH=.cache/chroma
CHROMA_COLLECTION=synthetic_technician_wiki
CHROMA_EMBEDDING_DIMENSIONS=384
CHROMA_REBUILD=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
LLAMA_CPP_MODEL_PATH=/path/to/model.gguf
LLAMA_CPP_N_CTX=4096
LLAMA_CPP_N_GPU_LAYERS=0
OPENAI_COMPAT_BASE_URL=http://localhost:1234/v1
OPENAI_COMPAT_MODEL=local-model
OPENAI_COMPAT_API_KEY=
# vLLM example:
# OPENAI_COMPAT_BASE_URL=http://localhost:8001/v1
# OPENAI_COMPAT_MODEL=sideboard-tech-model
# OPENAI_COMPAT_API_KEY=local-dev-token
HF_PROBE_MODEL=distilgpt2
HF_PROBE_DEVICE=auto
HF_PROBE_LAYER=-1
HF_PROBE_THRESHOLD=0.72
RESULTS_PATH=experiments/results.csv
